{
    "name": "napcat-plugin-currency-price",
    "plugin": "千岛通货价格",
    "description": "定时抓取千岛各游戏的通货价格并推送到群聊 / 私聊",
    "version": "1.0.0",
    "type": "module",
    "main": "index.mjs",
    "author": "Yiero",
    "license": "MIT",
    "keywords": [
        "napcat",
        "plugin",
        "qq",
        "currency",
        "price"
    ],
    "napcat": {
        "tags": [
            "工具"
        ],
        "minVersion": "4.14.0",
        "homepage": "https://github.com/AliubYiero/napcat-plugin-currency-price"
    },
    "dependencies": {
        "napcat-types": "0.0.16",
        "playwright-core": "^1.63.0"
    },
    "devDependencies": {
        "@napcat-plugin-template/shared": "workspace:*",
        "@napcat-plugin-template/webui": "workspace:*",
        "@rollup/plugin-node-resolve": "^15.3.1",
        "@types/express": "^5.0.6",
        "@types/node": "^20.19.33",
        "happy-dom": "^20.14.5",
        "napcat-plugin-debug-cli": "^1.2.8",
        "typescript": "^5.9.3",
        "vite": "^6.4.1",
        "vitest": "^5.0.1",
        "ws": "^8.19.0"
    },
    "scripts": {
        "build": "vite build",
        "watch": "vite build --watch",
        "help:generate": "node scripts/generateHelp/index.ts",
        "test": "vitest run",
        "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json"
    }
}
