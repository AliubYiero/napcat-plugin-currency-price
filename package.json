{
    "name": "napcat-plugin-template-monorepo",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "build": "pnpm --filter @napcat-plugin-template/webui build && pnpm --filter napcat-plugin-currency-price build",
        "dev:webui": "pnpm --filter @napcat-plugin-template/webui dev",
        "watch": "pnpm --filter napcat-plugin-currency-price watch",
        "typecheck": "pnpm -r typecheck",
        "format": "biome format --write"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.10"
    }
}
